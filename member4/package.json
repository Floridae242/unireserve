{
  "name": "unireserve-booking",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --require ts-node/register src/index.ts",
    "build": "tsc",
